.workbuddy/tmp/*.png
.workbuddy/tmp/*.jpg
.workbuddy/tmp/*.jpeg
.workbuddy/tmp/*.webp
.workbuddy/tmp/*.log
.workbuddy/tmp/_bak*
.workbuddy/tmp/_cand*
.workbuddy/tmp/_trash/

# 平台标记文件与本地连接配置
*.genie
.workbuddy/applications.yaml

.DS_Store
